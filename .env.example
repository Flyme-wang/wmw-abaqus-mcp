# Documentation only: set variables in the appropriate process.
# The Python programs do not automatically load this .env file.
ABAQUS_MCP_HOST=127.0.0.1
ABAQUS_MCP_PORT=48152
ABAQUS_MCP_PORT_RANGE_START=48152
ABAQUS_MCP_PORT_RANGE_END=48162
ABAQUS_MCP_TIMEOUT=60
ABAQUS_MCP_HOME=C:\path\to\wmw-abaqus-mcp
# Client-side maximum response size (bytes).
ABAQUS_MCP_MAX_MESSAGE_BYTES=33554432
# Bridge-process de-duplication capacity. Read only at runtime initialization.
# Capacity exhaustion rejects new IDs; it never resets or restarts CAE.
ABAQUS_MCP_ID_HISTORY_LIMIT=65536
# Optional GUI bridge settings. Automatic startup stays disabled by default.
ABAQUS_MCP_AUTOSTART=0
# ABAQUS_MCP_LOG=C:\path\to\bridge.log
